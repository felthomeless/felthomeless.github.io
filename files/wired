# ----- grub editor: timeout, quiet, background, any parameter -----

grub_set() { $SUDO sed -i "/^#*$1=/d" /etc/default/grub; echo "$1=$2" | $SUDO tee -a /etc/default/grub >/dev/null; }
grub_param() {
p=$2; k=${p%%=*}
cur=$(sed -n 's/^GRUB_CMDLINE_LINUX_DEFAULT="\(.*\)"/\1/p' /etc/default/grub)
new=""
for w in $cur; do case "$w" in "$k"|"$k="*) continue ;; esac; new="$new $w"; done
[ "$1" = add ] && new="$new $p"
new=$(echo "$new" | sed 's/^ *//; s/ *$//')
grub_set GRUB_CMDLINE_LINUX_DEFAULT "\"$new\""
}
tl_grub() {
g=/etc/default/grub
[ -f "$g" ] || { echo "no $g"; pause; return 0; }
while true; do
clear
grep '^GRUB_CMDLINE_LINUX_DEFAULT\|^GRUB_TIMEOUT=\|^GRUB_BACKGROUND' "$g"
cat << 'EOF'
1 timeout        2 quiet on/off        3 background image
4 add param      5 remove param        6 apply (grub-mkconfig)
7 recommended set (amd_pstate, iomem, aspm, nvme, backlight dim)     b back
EOF
printf " "; read -r c
case "$c" in
1) printf "seconds (0 = no wait): "; read -r v; case "$v" in ''|*[!0-9]*) ;; *) grub_set GRUB_TIMEOUT "$v" ;; esac ;;
2) if grep '^GRUB_CMDLINE_LINUX_DEFAULT' "$g" | grep -q quiet; then grub_param del quiet; else grub_param add quiet; fi ;;
3) printf "image path (png/jpg/tga): "; read -r v; if [ -f "$v" ]; then grub_set GRUB_BACKGROUND "\"$v\""; else echo "no such file"; fi ;;
4) printf "param (e.g. amd_pstate=passive): "; read -r v; [ -n "$v" ] && grub_param add "$v" ;;
5) printf "param to remove (name only): "; read -r v; [ -n "$v" ] && grub_param del "${v%%=*}" ;;
6) $SUDO grub-mkconfig -o /boot/grub/grub.cfg 2>&1 | tail -2; echo "reboot to apply"; pause ;;
7) grub_param add amd_pstate=passive; grub_param add iomem=relaxed; grub_param add pcie_aspm.policy=powersupersave
   grub_param add nvme_core.default_ps_max_latency_us=5500; grub_param add amdgpu.abmlevel=3; grub_set GRUB_TIMEOUT 1
   echo "recommended set written. apply with 6"; pause ;;
b) return ;;
esac
done
}

# ----- devices: type a number to flip one, 8 = all off, 9 = all on, or name on|off. saved, back after reboot -----

usb_live() {
for v in /sys/bus/usb/devices/*/idVendor; do
  [ -e "$v" ] || continue
  ud=${v%/*}
  if [ "$(cat "$v" 2>/dev/null):$(cat "$ud/idProduct" 2>/dev/null)" = "$1" ]; then
    [ "$(cat "$ud/authorized" 2>/dev/null)" = 1 ] && echo on || echo off
    return
  fi
done
echo none
}

usbauth() {
for v in /sys/bus/usb/devices/*/idVendor; do
  [ -e "$v" ] || continue
  ud=${v%/*}
  if [ "$(cat "$v" 2>/dev/null):$(cat "$ud/idProduct" 2>/dev/null)" = "$1" ]; then
    printf '%s\n' "$2" > "$ud/authorized" 2>/dev/null
  fi
done
}

net_live() {
nfound=no
for ni in /sys/class/net/$1*; do
  [ -e "$ni/flags" ] || continue
  nfound=yes
  case "$(cat "$ni/flags")" in *[13579bdfBDF]) echo on; return ;; esac
done
[ "$nfound" = yes ] && echo off || echo none
}

netset() {
for ni in /sys/class/net/$1*; do
  [ -e "$ni/flags" ] || continue
  if [ "$2" = 1 ]; then ip link set "${ni##*/}" down 2>/dev/null; else ip link set "${ni##*/}" up 2>/dev/null; fi
done
}

mod() { grep -q "^$1 " /proc/modules 2>/dev/null; }

dev_live() {
case "$1" in
  bluetooth)
    bs=on
    for r in /sys/class/rfkill/rfkill*; do
      [ -e "$r/type" ] || continue
      [ "$(cat "$r/type")" = bluetooth ] && [ "$(cat "$r/soft")" = 1 ] && bs=off
    done
    mod btusb || bs=off
    echo "$bs" ;;
  sound) if mod snd_hda_intel; then echo on; else echo off; fi ;;
  camera) if mod uvcvideo; then echo on; else echo off; fi ;;
  ethernet) net_live e ;;
  wifi) net_live wl ;;
  cardreader) usb_live 058f:9540 ;;
  fingerprint) usb_live 06cb:00bd ;;
esac
}

dev_apply() {
off=0; [ "$2" = off ] && off=1
case "$1" in
  bluetooth)
    if [ "$off" = 1 ]; then rfkill block bluetooth 2>/dev/null; modprobe -r btusb 2>/dev/null
    else modprobe btusb 2>/dev/null; rfkill unblock bluetooth 2>/dev/null; fi ;;
  sound)
    if [ "$off" = 1 ]; then modprobe -r snd_hda_intel 2>/dev/null || echo "sound is busy: close audio apps first"
    else modprobe snd_hda_intel 2>/dev/null; fi ;;
  camera)
    if [ "$off" = 1 ]; then modprobe -r uvcvideo 2>/dev/null; else modprobe uvcvideo 2>/dev/null; fi ;;
  ethernet) netset e "$off" ;;
  wifi) netset wl "$off" ;;
  cardreader) usbauth 058f:9540 $((1-off)) ;;
  fingerprint) usbauth 06cb:00bd $((1-off)) ;;
esac
}

dev_set() {
dev_apply "$1" "$2"
touch /etc/wired-devices
{ grep -v "^$1=" /etc/wired-devices; echo "$1=$2"; } > /etc/wired-devices.new && mv /etc/wired-devices.new /etc/wired-devices
hook_install
echo "$1: $2 (saved, comes back the same after reboot)"
}

dev_flip() {
s=$(dev_live "$1")
if [ "$s" = on ]; then s=off; else s=on; fi
$SUDO sh "$SELF" dev_set "$1" "$s"
}

devices_boot() {
[ -f /etc/wired-devices ] || return 0
while IFS='=' read -r n s; do [ -n "$n" ] && dev_apply "$n" "$s"; done < /etc/wired-devices
return 0
}

dev_menu() {
while true; do
clear
echo "devices (b back)"
i=1
for d in $DEVICES; do printf '  %s  %-12s %s\n' "$i" "$d" "$(dev_live "$d")"; i=$((i+1)); done
echo "  8  all off        9  all on"
echo "  or type: name on|off"
printf ' '
read -r pick a || return
case "$pick" in
  b|B|"") return ;;
  8) for d in $DEVICES; do $SUDO sh "$SELF" dev_set "$d" off; done ;;
  9) for d in $DEVICES; do $SUDO sh "$SELF" dev_set "$d" on; done ;;
  [1-7]) d=$(echo $DEVICES | cut -d' ' -f"$pick"); dev_flip "$d" ;;
  *)
    case " $DEVICES " in
      *" $pick "*) ;;
      *) echo "unknown: $pick"; pause; continue ;;
    esac
    case "$a" in
      on|off) $SUDO sh "$SELF" dev_set "$pick" "$a" ;;
      *) dev_flip "$pick" ;;
    esac ;;
esac
done
}

# ----- battery saver: now, and saved for reboot -----

save_apply() {
for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do sysw powersave "$g"; done
for g in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do sysw power "$g"; done
sysw 0 /sys/devices/system/cpu/cpufreq/boost
for p in /sys/bus/pci/devices/*/power/control /sys/bus/usb/devices/*/power/control; do sysw auto "$p"; done
sysw powersupersave /sys/module/pcie_aspm/parameters/policy
for d in /sys/class/drm/card[0-9]/device/power_dpm_force_performance_level; do sysw low "$d"; done
if command -v iw >/dev/null 2>&1; then
  for n in /sys/class/net/w*; do [ -e "$n" ] && iw dev "${n##*/}" set power_save on 2>/dev/null; done
fi
if [ -n "$RYZEN_W" ] && command -v ryzenadj >/dev/null 2>&1; then
  ryzenadj --stapm-limit=$((RYZEN_W*1000)) --fast-limit=$((RYZEN_W*1000)) --slow-limit=$((RYZEN_W*1000)) --tctl-temp=75 >/dev/null 2>&1
fi
echo "battery saver applied"
}

save_undo() {
gv=schedutil; grep -q schedutil /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors 2>/dev/null || gv=ondemand
for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do sysw "$gv" "$g"; done
for g in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do sysw balance_performance "$g"; done
sysw 1 /sys/devices/system/cpu/cpufreq/boost
sysw default /sys/module/pcie_aspm/parameters/policy
for d in /sys/class/drm/card[0-9]/device/power_dpm_force_performance_level; do sysw auto "$d"; done
echo "battery saver off (governor $gv)"
}

save_on() { $SUDO touch /etc/wired-saver && $SUDO sh "$SELF" save_apply; $SUDO sh "$SELF" hook_install; pause; }
save_off() { $SUDO rm -f /etc/wired-saver; $SUDO sh "$SELF" save_undo; pause; }

# installs the boot hook: a copy of this script runs "boot" at every start
hook_install() {
mkdir -p /usr/local/lib/wired /etc/local.d
[ "$SELF" = /usr/local/lib/wired/wired.sh ] || cp "$SELF" /usr/local/lib/wired/wired.sh
printf '#!/bin/sh\nsh /usr/local/lib/wired/wired.sh boot\n' > /etc/local.d/wired.start
chmod +x /etc/local.d/wired.start
rc-update add local default >/dev/null 2>&1
}

boot_hook() { $SUDO sh "$SELF" hook_install; echo "boot hook installed: saved battery saver and devices come back after every reboot"; pause; }

boot() { [ -f /etc/wired-saver ] && save_apply; devices_boot; return 0; }

# ----- optimize: battery and gpu settings now -----

on_bat() { for f in /sys/class/power_supply/*/online; do [ -f "$f" ] || continue; case "$f" in *AC*|*ADP*) [ "$(cat "$f")" = 0 ] && return 0 ;; esac; done; return 1; }
optimize() {
[ -f /etc/X11/xorg.conf.d/20-noglamor.conf ] && $SUDO rm -f /etc/X11/xorg.conf.d/20-noglamor.conf && echo "removed 20-noglamor.conf (applies after X restarts)"
if [ -n "$DISPLAY" ] && command -v glxinfo >/dev/null 2>&1; then
r=$(glxinfo -B 2>/dev/null | sed -n 's/^OpenGL renderer string: //p')
case "$r" in "") echo "renderer unknown" ;; *llvmpipe*) echo "WARNING: software rendering ($r). restart X." ;; *) echo "renderer: $r" ;; esac
fi
if on_bat && [ -n "$DISPLAY" ] && command -v xrandr >/dev/null 2>&1; then
out=$(xrandr --query | awk '/ connected/ {print $1; exit}')
cur=$(xrandr --query | awk -v o="$out" '$1 == o {on=1; next} /^[^ ]/ {on=0} on && /\*/ {for (i=2;i<=NF;i++) if ($i ~ /\*/) {r=$i; gsub(/[*+]/,"",r); print r; exit}}')
if [ -n "$out" ] && [ -n "$cur" ] && awk -v c="$cur" 'BEGIN{exit !(c > 60.5)}'; then xrandr --output "$out" --rate 60 2>/dev/null && echo "$out: $cur Hz -> 60 Hz on battery"; fi
fi
if on_bat && command -v iw >/dev/null 2>&1; then
for i in $(iw dev 2>/dev/null | awk '$1=="Interface"{print $2}'); do $SUDO iw dev "$i" set power_save on 2>/dev/null && echo "wifi $i power save on"; done
fi
for p in /sys/class/drm/card[0-9]/device/power_dpm_force_performance_level; do [ -f "$p" ] && sysw auto "$p" >/dev/null; done
echo "optimize done"
}

