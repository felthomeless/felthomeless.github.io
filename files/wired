cat > "$tmp/ex.sh" <<'X'
greet() { echo "hi $1"; }
add() { echo $(($1 + $2)); }
isbig() { [ "$1" -gt 100 ]; }
greet berber
sum=$(add 20 22); echo "sum: $sum"
isbig 500 && echo "500 is big"
isbig 5 || echo "5 is not big"
leak() { x=changed; }
x=original; leak; echo "after leak(): $x"
noleak() ( x=changed2 )
x=original; noleak; echo "after noleak(): $x"
X
;;
7) cat <<'T'
ARGUMENTS AND OPTIONS
$0 script name   $1 $2 .. the arguments   $# how many   "$@" all of them   $$ pid
shift            drop $1, everything moves down one
set -- a b c     set the list yourself. this is how you build lists without arrays:
