#!/bin/sh

CHROOT_DIR="${CHROOT_DIR:-$HOME/glibc}"
GAMES_DIR="${GAMES_DIR:-$HOME/}"
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
if [ -z "$1" ] && [ ! -t 1 ]; then
for t in "${TERMINAL:-}" urxvt xterm st alacritty; do
[ -n "$t" ] && command -v "$t" >/dev/null 2>&1 && exec "$t" -e sh "$SELF"
done
exit 1
fi
printf '\033[38;2;185;174;220m\033[0m'

ui=1
art=1
base="${HOME:-/root}/.mfcore"
tmp="$base/tmp"
mkdir -p "$tmp" 2>/dev/null
[ -s "$base/chroot" ] && CHROOT_DIR=$(cat "$base/chroot")
RYZEN_W=""   # battery saver: cpu watt limit (ryzenadj), e.g. 8. empty = leave ryzenadj alone
KSRC=""      # kernel source folder. empty = newest /usr/src/linux*
DEVICES="bluetooth sound camera ethernet wifi cardreader fingerprint"

if [ "$(id -u)" -eq 0 ]; then SUDO=""; else SUDO="sudo"; fi

clear() { printf '\033[H\033[2J'; }
pause() { printf 'press enter... '; read -r _; }
ask() { printf '%s [y/n]: ' "$1"; read -r a; [ "$a" = y ]; }

# one key with a timeout in tenths of a second (works in any sh)
readkey() {
key=""
rk_old=$(stty -g 2>/dev/null) || { sleep 1; return 0; }
stty -icanon -echo min 0 time "$1" 2>/dev/null
key=$(dd bs=1 count=1 2>/dev/null)
stty "$rk_old" 2>/dev/null
}

trap 'stty sane 2>/dev/null' EXIT

# ---- layer stack: b goes back to the layer you came from ----
screen=main
stack=""
go() { stack="$stack $screen"; screen=$1; }
back() {
set -- $stack; new=""
[ $# -eq 0 ] && { screen=main; return; }
while [ $# -gt 1 ]; do new="$new $1"; shift; done
screen=$1; stack=$new
}

elevate() {
if [ -z "$SUDO" ]; then echo "you are root already"; pause; return; fi
sudo -v && echo "sudo unlocked for a few minutes"
pause
}

