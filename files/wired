2) clear; echo "memory hogs:"; ps aux --sort=-%mem 2>/dev/null | head -8; pause ;;
3) clear; printf "larger than (MB): "; read -r size
case "$size" in ''|*[!0-9]*) echo "number only." ;; *) find / -xdev -type f -size +"${size}"M 2>/dev/null | head -20 ;; esac
pause ;;
4) clear; echo "cleaning..."
rm -rf "$HOME"/.cache/* "$HOME"/.local/share/Trash/* 2>/dev/null
