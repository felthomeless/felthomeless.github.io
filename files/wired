    pkill -x pipewire-pulse 2>/dev/null; pkill -x wireplumber 2>/dev/null; pkill -x pipewire 2>/dev/null; sleep 1
    (pipewire >/dev/null 2>&1 &); (wireplumber >/dev/null 2>&1 &); (pipewire-pulse >/dev/null 2>&1 &)
  elif command -v pulseaudio >/dev/null 2>&1; then
    pulseaudio -k >/dev/null 2>&1; sleep 1; pulseaudio --start >/dev/null 2>&1
