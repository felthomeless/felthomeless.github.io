5) clear; echo "network status:"; ip addr show; echo "---"; { netstat -tuln 2>/dev/null || ss -tuln; }; pause ;;
6) clear; ps aux | head -30; printf "kill pid: "; read -r pid
case "$pid" in ''|*[!0-9]*) echo "number only." ;; *) kill -9 "$pid" 2>/dev/null || $SUDO kill -9 "$pid"; echo "done." ;; esac
pause ;;
7) clear; echo "backing up..."
out="$HOME/config-backup-$(date +%s).tar.gz"
$SUDO tar -czf "$out" /etc 2>/dev/null && $SUDO chown "$(id -u)" "$out"
echo "saved: $out"; pause ;;
8) clear; printf "package name: "; read -r pkg; [ -n "$pkg" ] && $SUDO apk add $pkg; pause ;;
b) break ;;
esac
