tl_chroot_install() {
clear
echo "install a new chroot (your current one is not touched)"
echo "1) void (glibc)  2) void (musl)  3) gentoo (openrc)  4) arch"
printf "[1]: "
read -r dist
[ -z "$dist" ] && dist=1
case "$dist" in
1) nm=void ;;
2) nm=void-musl ;;
3) nm=gentoo ;;
4) nm=arch ;;
*) return 0 ;;
esac
printf "dir [$HOME/chroot-$nm]: "
read -r nd
[ -z "$nd" ] && nd="$HOME/chroot-$nm"
if [ -e "$nd" ] && [ -n "$(ls -A "$nd" 2>/dev/null)" ]; then
echo "error: $nd is not empty. nothing was changed."
pause
return 0
fi
case "$dist" in
1|2)
vb=https://repo-default.voidlinux.org/live/current
if [ "$dist" = 1 ]; then vp='void-x86_64-ROOTFS-[0-9]*\.tar\.xz'; else vp='void-x86_64-musl-ROOTFS-[0-9]*\.tar\.xz'; fi
vf=$(fetch_txt "$vb/" | grep -o "$vp" | sort -u | tail -1)
[ -z "$vf" ] && { echo "error: could not read $vb"; pause; return 0; }
echo "downloading $vf ..."
dl "$vb/$vf" "$tmp/$vf" || { echo "download failed."; pause; return 0; }
$SUDO mkdir -p "$nd" && $SUDO tar xpf "$tmp/$vf" -C "$nd" || { echo "extract failed."; pause; return 0; }
rm -f "$tmp/$vf"
chroot_prepare "$nd"
echo "updating void inside the new chroot..."
chroot_exec "$nd" sh -c 'mkdir -p /etc/xbps.d && cp /usr/share/xbps.d/*-repository-*.conf /etc/xbps.d/ 2>/dev/null; xbps-install -Suy xbps && xbps-install -uy && xbps-install -y base-system && xbps-remove -y base-voidstrap; xbps-reconfigure -fa'
;;
3)
gu=https://distfiles.gentoo.org/releases/amd64/autobuilds
gp=$(fetch_txt "$gu/latest-stage3-amd64-openrc.txt" | grep -o '[0-9TZ]*/stage3-amd64-openrc-[0-9TZ]*\.tar\.xz' | head -1)
[ -z "$gp" ] && { echo "error: could not read the gentoo stage3 list"; pause; return 0; }
echo "downloading $gp ..."
dl "$gu/$gp" "$tmp/stage3.tar.xz" || { echo "download failed."; pause; return 0; }
$SUDO mkdir -p "$nd" && { $SUDO tar xpf "$tmp/stage3.tar.xz" --xattrs-include='*.*' --numeric-owner -C "$nd" 2>/dev/null || $SUDO tar xpf "$tmp/stage3.tar.xz" --numeric-owner -C "$nd"; } || { echo "extract failed."; pause; return 0; }
rm -f "$tmp/stage3.tar.xz"
chroot_prepare "$nd"
printf "sync the portage tree now (emerge-webrsync)? (y/n): "
read -r y
[ "$y" = "y" ] && chroot_exec "$nd" emerge-webrsync
;;
4)
command -v zstd >/dev/null 2>&1 || $SUDO apk add zstd || { pause; return 0; }
echo "downloading the arch bootstrap ..."
dl https://geo.mirror.pkgbuild.com/iso/latest/archlinux-bootstrap-x86_64.tar.zst "$tmp/arch.tar.zst" || { echo "download failed."; pause; return 0; }
$SUDO mkdir -p "$nd" && zstd -dc "$tmp/arch.tar.zst" | $SUDO tar xp --numeric-owner --strip-components=1 -C "$nd" || { echo "extract failed."; pause; return 0; }
rm -f "$tmp/arch.tar.zst"
$SUDO mount --bind "$nd" "$nd"
chroot_prepare "$nd"
chroot_exec "$nd" sh -c 'echo "Server = https://geo.mirror.pkgbuild.com/\$repo/os/\$arch" > /etc/pacman.d/mirrorlist && pacman-key --init && pacman-key --populate archlinux && pacman -Sy --noconfirm'
;;
esac
echo ""
echo "installed: $nd"
printf "create user berber in it? (y/n): "
read -r y
if [ "$y" = "y" ]; then
chroot_exec "$nd" useradd -m berber
chroot_exec "$nd" passwd berber
fi
printf "use it as the active chroot now? (y/n): "
read -r y
[ "$y" = "y" ] && set_active_chroot "$nd"
pause
}

# sound inside the chroot. pulse only accepts a client whose uid matches the server's,
# so the chroot user is given your uid. the test runs as that user with its own environment.
tl_chroot_sound() {
clear
sc_dir="$CHROOT_DIR"
sc_uid=$(id -u)
[ -d "$sc_dir" ] || { echo "error: $sc_dir not found."; pause; return 0; }
printf "chroot user to test [berber]: "; read -r sc_usr; [ -n "$sc_usr" ] || sc_usr=berber

chroot_prepare "$sc_dir"
audio_up

if [ "$sc_usr" = root ]; then
  sc_cuid=0; sc_home=/root
else
  sc_cuid=$($SUDO chroot "$sc_dir" id -u "$sc_usr" 2>/dev/null)
  [ -n "$sc_cuid" ] || { echo "user $sc_usr is not in the chroot. add it first (ua)"; pause; return 0; }
  sc_home=/home/$sc_usr
  if [ "$sc_cuid" != "$sc_uid" ]; then
    echo "chroot user $sc_usr is uid $sc_cuid, you are uid $sc_uid. pulse only lets matching uids in."
    ask "change $sc_usr to uid $sc_uid inside the chroot" || { echo "not changed. sound will not work for $sc_usr"; pause; return 0; }
    $SUDO chroot "$sc_dir" usermod -u "$sc_uid" "$sc_usr" || { echo "usermod failed: uid $sc_uid may be taken in the chroot"; pause; return 0; }
    $SUDO chroot "$sc_dir" chown -R "$sc_uid" "$sc_home" 2>/dev/null
    sc_cuid=$sc_uid
  fi
fi

cookie="$HOME/.config/pulse/cookie"
if [ -f "$cookie" ] && [ "$sc_usr" != root ]; then
  $SUDO mkdir -p "$sc_dir$sc_home/.config/pulse"
  $SUDO cp "$cookie" "$sc_dir$sc_home/.config/pulse/cookie"
  $SUDO chown -R "$sc_cuid" "$sc_dir$sc_home/.config"
fi

if ! $SUDO chroot "$sc_dir" sh -c 'command -v pactl && command -v pacat && command -v aplay' >/dev/null 2>&1; then
  echo "installing pulse and alsa tools in the chroot..."
  chroot_exec "$sc_dir" sh -c 'cp /usr/share/xbps.d/*-repository-*.conf /etc/xbps.d/ 2>/dev/null; xbps-install -Sy pulseaudio-utils alsa-utils alsa-plugins-pulseaudio' || echo "install failed: read the message above"
fi

if [ ! -f "$sc_dir/etc/asound.conf" ]; then
  printf 'pcm.!default {\n  type pulse\n}\nctl.!default {\n  type pulse\n}\n' | $SUDO tee "$sc_dir/etc/asound.conf" >/dev/null
fi

host_srv=none
pgrep -x pulseaudio >/dev/null 2>&1 && host_srv=pulseaudio
pgrep -x pipewire-pulse >/dev/null 2>&1 && host_srv=pipewire-pulse
echo "host sound server:        $host_srv"
echo "host socket:              $([ -S "/run/user/$sc_uid/pulse/native" ] && echo yes || echo NO)"
echo "socket visible in chroot: $([ -S "$sc_dir/run/user/$sc_uid/pulse/native" ] && echo yes || echo NO)"
echo "/dev/snd in chroot:       $(ls "$sc_dir/dev/snd" 2>/dev/null | wc -l) nodes"

cat > "$tmp/sound-test.sh" <<EOF
export HOME=$sc_home
export XDG_RUNTIME_DIR=/run/user/$sc_cuid
export PULSE_SERVER=unix:/run/user/$sc_cuid/pulse/native
export PULSE_COOKIE=$sc_home/.config/pulse/cookie
if pactl info >/dev/null 2>&1; then
  pactl info 2>/dev/null | awk -F': ' '/Server Name/{print "pulse server: " \$2}'
  pactl info 2>/dev/null | awk -F': ' '/Default Sink/{print "default sink: " \$2}'
else
  echo "pulse server: NOT reachable"
fi
echo "alsa cards: \$(aplay -l 2>/dev/null | grep -c '^card')"
if [ "\$1" = play ]; then
  head -c 88200 /dev/urandom | pacat --rate=44100 --format=s16le --channels=1 --volume=6000 && echo "pulse pipe: ok"
  head -c 88200 /dev/urandom | aplay -q -f S16_LE -r 44100 -c 1 && echo "alsa to pulse: ok"
fi
EOF
$SUDO cp "$tmp/sound-test.sh" "$sc_dir/tmp/sound-test.sh"
mode=check
ask "play a short quiet noise burst inside the chroot" && mode=play
if [ "$sc_usr" = root ]; then
  $SUDO chroot "$sc_dir" sh /tmp/sound-test.sh "$mode"
else
  $SUDO chroot "$sc_dir" su "$sc_usr" -s /bin/sh -c "sh /tmp/sound-test.sh $mode"
fi
$SUDO rm -f "$sc_dir/tmp/sound-test.sh"
echo ""
echo "if it says NOT reachable, the host sound server is down: run aud and try again"
pause
}

