tl_bat_status() {
clear
ac=no
for s in /sys/class/power_supply/*; do
[ "$(cat "$s/type" 2>/dev/null)" = Mains ] && [ "$(cat "$s/online" 2>/dev/null)" = 1 ] && ac=yes
done
echo "ac       $ac"
b=$(bat_dir)
if [ -n "$b" ]; then
st=$(cat "$b/status" 2>/dev/null)
cap=$(cat "$b/capacity" 2>/dev/null)
pw=$(cat "$b/power_now" 2>/dev/null)
if [ -z "$pw" ] || [ "$pw" = 0 ]; then
cu=$(cat "$b/current_now" 2>/dev/null)
vo=$(cat "$b/voltage_now" 2>/dev/null)
[ -n "$cu" ] && [ -n "$vo" ] && pw=$((cu * vo / 1000000))
fi
en=$(cat "$b/energy_now" 2>/dev/null)
if [ -z "$en" ]; then
cn=$(cat "$b/charge_now" 2>/dev/null)
vo=$(cat "$b/voltage_now" 2>/dev/null)
[ -n "$cn" ] && [ -n "$vo" ] && en=$((cn * vo / 1000000))
fi
watts=$(awk -v p="${pw:-0}" 'BEGIN{printf "%.2f", p/1000000}')
left=$(awk -v e="${en:-0}" -v p="${pw:-0}" 'BEGIN{if (p>0) printf "%.1f", e/p; else print "n/a"}')
case "$st" in
Charging) echo "battery  $cap% charging at $watts W" ;;
Discharging) echo "battery  $cap% draining $watts W, about $left h left" ;;
*) echo "battery  $cap% ($st)" ;;
esac
fi
if command -v ryzenadj >/dev/null 2>&1; then
ri=$($SUDO ryzenadj -i 2>/dev/null)
pk=$(printf '%s\n' "$ri" | awk -F'|' '/PPT VALUE SLOW/{gsub(/ /,"",$3); print $3; exit}')
[ -z "$pk" ] && pk=$(printf '%s\n' "$ri" | awk -F'|' '/STAPM VALUE/{gsub(/ /,"",$3); print $3; exit}')
echo "chip     ${pk:-n/a} W now (cpu + gpu)"
else
echo "chip     n/a (ryz installs ryzenadj)"
fi
echo ""
echo "boost    $(cat /sys/devices/system/cpu/cpufreq/boost 2>/dev/null || echo n/a)  (1 = on)"
echo "smt      $(cat /sys/devices/system/cpu/smt/control 2>/dev/null || echo n/a)"
echo "governor $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo n/a)"
echo "pstate   $(cat /sys/devices/system/cpu/amd_pstate/status 2>/dev/null || echo n/a)"
echo "gpu      $(cat /sys/class/drm/card*/device/power_dpm_force_performance_level 2>/dev/null | head -1)"
echo "aspm     $(cat /sys/module/pcie_aspm/parameters/policy 2>/dev/null)"
pause
}

