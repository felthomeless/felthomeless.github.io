find_chmod_sh() {
while true; do
printf "target directory (b to back): "
read -r target_dir
target_dir=$(printf '%s' "$target_dir" | tr -d '\r' | sed 's/[[:space:]]*$//')
case "$target_dir" in
b|B) break ;;
"~"*) target_dir="$HOME${target_dir#\~}" ;;
esac
if [ ! -d "$target_dir" ]; then
echo "error: '$target_dir' is not a directory."
continue
fi
find "$target_dir" -type f -name "*.sh" | while IFS= read -r file; do
if chmod +x "$file" 2>/dev/null || $SUDO chmod +x "$file"; then
echo "made executable: $file"
else
echo "failed: $file"
fi
done
echo "done."
echo ""
done
}

