diskhealth() {
clear
for dev in sdb sdc sdd sde nvme0n1; do
  [ -b "/dev/$dev" ] || continue
  echo "=== /dev/$dev ==="
  $SUDO smartctl -H "/dev/$dev" 2>&1 | grep -i "overall-health\|result"
  $SUDO smartctl -A "/dev/$dev" 2>&1 | grep -E "Reallocated_Sector|Current_Pending_Sector|Offline_Uncorrectable|Reported_Uncorrect|Temperature_Celsius|CRC_Error|Percentage Used|Available Spare"
  echo ""
done
pause
}

bar() {
n=$(( $1 / 5 )); b=""; i=0
while [ "$i" -lt 20 ]; do
if [ "$i" -lt "$n" ]; then b="$b#"; else b="$b-"; fi
i=$((i+1))
done
printf '[%s] %3d%%' "$b" "$1"
}

cpu_pct() {
read -r _ u n s i w q sq _ < /proc/stat
t1=$((u+n+s+i+w+q+sq)); i1=$((i+w))
sleep 0.5
read -r _ u n s i w q sq _ < /proc/stat
t2=$((u+n+s+i+w+q+sq)); i2=$((i+w))
dt=$((t2-t1))
if [ "$dt" -gt 0 ]; then echo $(( 100 * (dt - (i2 - i1)) / dt )); else echo 0; fi
}

mem_pct() {
awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{printf "%d", (t-a)*100/t}' /proc/meminfo
}

dmi() {
if [ "$(id -u)" -eq 0 ]; then dmidecode "$@"; else sudo -n dmidecode "$@"; fi
}

