wifi_restart() {
clear
echo "restarting wifi..."
iface=$(ip link | grep "wlan" | head -1 | awk '{print $2}' | tr -d ':')
[ -z "$iface" ] && iface="wlan0"
$SUDO modprobe rtl8xxxu 2>/dev/null || true
sleep 1
$SUDO pkill -f wpa_supplicant 2>/dev/null || true
$SUDO pkill -f udhcpc 2>/dev/null || true
sleep 1
$SUDO ip link set "$iface" down 2>/dev/null || true
sleep 1
$SUDO ip link set "$iface" up
sleep 2
$SUDO wpa_supplicant -B -i "$iface" -c /etc/wpa_supplicant/wpa_supplicant.conf -D nl80211,wext
sleep 3
count=0
while [ "$count" -lt 15 ]; do
state=$($SUDO wpa_cli -i "$iface" status 2>/dev/null | grep "wpa_state=" | cut -d= -f2)
if [ "$state" = "COMPLETED" ]; then
echo "connected"
break
fi
echo "waiting... ($count/15)"
sleep 1
count=$((count + 1))
done
$SUDO udhcpc -i "$iface" -n -q 2>/dev/null || $SUDO udhcpc -i "$iface" -S
sleep 1
echo ""
ip addr show "$iface" | grep "inet "
echo ""
pause
}

toggle_charge() {
clear
d=/sys/class/power_supply/BAT0
if [ ! -e "$d/charge_control_end_threshold" ]; then
echo "no charge limit support on this battery."
pause
return
fi
cur=$(cat "$d/charge_control_end_threshold")
if [ "$cur" = 80 ]; then n=100; else n=80; fi
echo 0 | $SUDO tee "$d/charge_control_start_threshold" >/dev/null 2>&1
echo "$n" | $SUDO tee "$d/charge_control_end_threshold" >/dev/null
echo $((n-5)) | $SUDO tee "$d/charge_control_start_threshold" >/dev/null 2>&1
if [ -d /etc/tlp.d ]; then
printf 'STOP_CHARGE_THRESH_BAT0=%s\nSTART_CHARGE_THRESH_BAT0=%s\n' "$n" $((n-5)) | $SUDO tee /etc/tlp.d/99-charge.conf >/dev/null
fi
echo "charge limit now: $(cat "$d/charge_control_end_threshold")%"
pause
}

# ---------- chroot ----------

# mounts everything the chroot needs, including your home folder at /mnt/home and /mnt/games.
# it only mounts onto the chroot directory. it never changes files inside the chroot or on your system.
chroot_prepare() {
cp_dir="${1:-$CHROOT_DIR}"
cp_uid=$(id -u)
cp_mnt() { cp_t="$1"; shift; mountpoint -q "$cp_dir/$cp_t" || $SUDO mount "$@" "$cp_dir/$cp_t" 2>/dev/null; }
$SUDO mkdir -p "$cp_dir/tmp/.X11-unix" "$cp_dir/run/user/$cp_uid" "$cp_dir/dev/shm" "$cp_dir/proc" "$cp_dir/sys" "$cp_dir/dev" "$cp_dir/mnt/games" "$cp_dir/mnt/home"
cp_mnt dev --rbind /dev
$SUDO mount --make-rslave "$cp_dir/dev" 2>/dev/null
cp_mnt proc --rbind /proc
$SUDO mount --make-rslave "$cp_dir/proc" 2>/dev/null
cp_mnt sys -t sysfs sys
cp_mnt dev/shm --bind /dev/shm
cp_mnt tmp/.X11-unix --bind /tmp/.X11-unix
cp_mnt run/user/"$cp_uid" --bind "/run/user/$cp_uid"
cp_mnt mnt/games --bind "$GAMES_DIR"
cp_mnt mnt/home --bind "$GAMES_DIR"
$SUDO cp -n /etc/resolv.conf "$cp_dir/etc/resolv.conf" 2>/dev/null
}

chroot_exec() {
ce_dir="$1"
shift
ce_uid=$(id -u)
$SUDO env -i DISPLAY="$DISPLAY" XDG_RUNTIME_DIR="/run/user/$ce_uid" PULSE_SERVER="unix:/run/user/$ce_uid/pulse/native" HOME=/root TERM=xterm-256color LANG=C.UTF-8 PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin chroot "$ce_dir" "$@"
}

# unmounts everything the chroot got. never touches files inside the chroot
chroot_unmount_all() {
c="$CHROOT_DIR"; u=$(id -u)
for m in mnt/games mnt/home run/user/$u tmp/.X11-unix dev/shm sys proc dev; do
mountpoint -q "$c/$m" && $SUDO umount -R "$c/$m" 2>/dev/null
done
}

# runs a command inside the chroot as a user, in the background (horizon, mocktail, any void app)
chroot_app() {
ca_user="$1"; shift
ca_cmd="$*"
ca_uid=$(id -u)
[ -d "$CHROOT_DIR" ] || { echo "error: $CHROOT_DIR not found."; pause; return; }
chroot_prepare "$CHROOT_DIR"
xhost +local: >/dev/null 2>&1
$SUDO chroot "$CHROOT_DIR" su "$ca_user" -s /bin/sh -c "export DISPLAY=$DISPLAY XDG_RUNTIME_DIR=/run/user/$ca_uid PULSE_SERVER=unix:/run/user/$ca_uid/pulse/native HOME=/home/$ca_user LANG=C.UTF-8; $ca_cmd" > "$tmp/app.log" 2>&1 &
echo "started: $ca_cmd (log: $tmp/app.log)"
sleep 2
}

chroot_shell() { # $1 user (empty = root)
c="$CHROOT_DIR"; u=$(id -u); as="$1"
[ -d "$c" ] || { echo "error: $c not found."; pause; return; }
[ -d "$GAMES_DIR" ] || { echo "error: $GAMES_DIR not found."; pause; return; }
chroot_prepare "$c"
if [ ! -s "$c/etc/machine-id" ] && [ -r /etc/machine-id ]; then
  $SUDO sh -c "cat /etc/machine-id > '$c/etc/machine-id'" 2>/dev/null
fi

xhost +local: >/dev/null 2>&1
sh_in=/bin/sh; [ -x "$c/bin/bash" ] && sh_in=/bin/bash

[ "$(cat /proc/sys/user/max_user_namespaces 2>/dev/null)" = 0 ] && $SUDO sysctl -w user.max_user_namespaces=10000 >/dev/null 2>&1
cat > "$tmp/enter.sh" <<'ENTER'
#!/bin/sh
c="$1"; sh_in="$2"; as="$3"
if command -v unshare >/dev/null 2>&1 && command -v pivot_root >/dev/null 2>&1; then
  exec unshare -m -- sh -c 'mount --make-rprivate / && mount --rbind "$1" "$1" && cd "$1" && mkdir -p .oldroot && pivot_root . .oldroot && { umount -l /.oldroot 2>/dev/null; true; } && if [ -n "$3" ]; then exec su "$3" -s "$2"; else exec "$2" -i; fi' sh "$c" "$sh_in" "$as"
fi
if [ -n "$as" ]; then exec chroot "$c" su "$as" -s "$sh_in"; fi
exec chroot "$c" "$sh_in" -i
ENTER

urxvt -e $SUDO env -i \
  DISPLAY="$DISPLAY" \
  XAUTHORITY="$HOME/.Xauthority" \
  XDG_RUNTIME_DIR="/run/user/$u" \
  PULSE_SERVER="unix:/run/user/$u/pulse/native" \
  LANG=C.UTF-8 \
  SDL_VIDEODRIVER=x11 \
  TERM=xterm-256color \
  HOME=/root \
  PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin \
     sh "$tmp/enter.sh" "$c" "$sh_in" "$as" &
}

chroot_stop() {
clear
echo "unmounting chroot..."
chroot_unmount_all
echo "done."
pause
}

set_active_chroot() {
CHROOT_DIR="$1"
