echo ""
case "$1" in
1) cat <<'T'
VARIABLES: setting them and using them
name=berber            set. no spaces around =
echo "$name"           use. $name, always in quotes
n=5; n=$((n + 1))      math. $(( )) does whole numbers only
today=$(date +%F)      store what a command prints
unset name             remove it
readonly pi=3          cannot be changed afterwards
export X=1             programs you start can see X. plain variables stay in the script
${v:-fallback}         use fallback when v is empty or unset
${v:=fallback}         same, and also store it in v
${v:?need v}           stop with an error when v is empty (a safety net)
${#v}                  length          ${v%.txt}   cut a suffix
${v##*/}               cut the path    ${v%/*}     keep only the folder
built in: $HOME $USER $PWD $PATH $0 (script name) $$ (pid) $? (last status)
exercise: put your hostname in a variable, print: host: NAME (N letters)
T
cat > "$tmp/ex.sh" <<'X'
f=/home/berber/music/song.final.mp3
echo "file:   ${f##*/}"
echo "folder: ${f%/*}"
echo "no ext: ${f%.*}"
echo "length: ${#f}"
unset maybe
echo "default: ${maybe:-nothing set}"
n=5; n=$((n * 2 + 1)); echo "math: $n"
host=$(uname -n); echo "host: $host (${#host} letters)"
X
;;
2) cat <<'T'
QUOTING AND WORD SPLITTING
"..."    $vars and $(commands) expand, spaces stay together
'...'    nothing expands, it is literal
\x       escapes one character
An unquoted $var is split on spaces and then glob-expanded. This is the bug
behind most broken scripts:
  f="my file.txt"; rm $f      tries to delete "my" and "file.txt"
  rm "$f"                     deletes the right file
"$@"     every argument kept whole.   $*  glues them into one string
IFS      the characters used for splitting (default: space, tab, newline)
rule: quote every expansion unless you want splitting on purpose
exercise: make a file called "a b.txt" and delete it the safe way
T
cat > "$tmp/ex.sh" <<'X'
f="my file.txt"
echo "unquoted:"; printf '  [%s]\n' $f
echo "quoted:";   printf '  [%s]\n' "$f"
echo 'single quotes keep $f literal'
echo "double quotes use $f"
set -- one "two words" three
echo "args: $#"; for a in "$@"; do printf '  <%s>\n' "$a"; done
X
;;
3) cat <<'T'
EXIT STATUS AND CHAINING
every command ends with a number: 0 = ok, 1-255 = failed. read it with $?
a && b       run b only if a worked
a || b       run b only if a failed
! a          flip the result
if a; then ... fi     the test is any command, not just [ ]
grep -q word file     quiet, it only sets the status
command -v foo >/dev/null 2>&1 || echo "foo missing"
exit 3       leave the script with status 3
return 3     leave a function with status 3
a && b || c  is not if/else: c also runs when b fails. use if when it matters
exercise: print "found" or "missing" depending on whether /etc/hostname exists
T
cat > "$tmp/ex.sh" <<'X'
true;  echo "true gives $?"
false; echo "false gives $?"
ls /nope 2>/dev/null; echo "ls /nope gives $?"
[ -d /etc ] && echo "/etc is a folder"
[ -d /nope ] || echo "/nope is not a folder"
if grep -q root /etc/passwd; then echo "root exists"; fi
if ! command -v nosuchtool >/dev/null 2>&1; then echo "nosuchtool is missing"; fi
X
;;
4) cat <<'T'
TESTS WITH [ ]
[ is a command, so spaces are required:  [ "$a" = "$b" ]
strings   =  !=  -z (empty)  -n (not empty)
numbers   -eq -ne -lt -le -gt -ge       [ 3 -lt 10 ]
files     -e exists  -f file  -d folder  -r -w -x  -s (not empty)  -L link
join      [ a ] && [ b ]   or   [ a ] || [ b ]     (skip -a and -o)
plain sh has no == and no [[ ]]
always quote: [ "$x" = y ] works when x is empty, [ $x = y ] breaks
comparing numbers as strings is a trap: [ 10 = 10.0 ] is false, [ 10 -eq 10 ] is true
exercise: print big when /etc has more than 50 entries
T
cat > "$tmp/ex.sh" <<'X'
a=7; b=10
[ "$a" -lt "$b" ] && echo "$a is less than $b"
[ "$a" = "$b" ] || echo "as strings they differ"
s=""
[ -z "$s" ] && echo "s is empty"
[ -f /etc/passwd ] && echo "passwd is a file"
[ -d /etc ] && [ -r /etc ] && echo "/etc is a readable folder"
n=$(ls /etc | wc -l)
if [ "$n" -gt 50 ]; then echo "big ($n entries)"; else echo "small ($n entries)"; fi
X
;;
5) cat <<'T'
LOOPS
for x in one two three; do echo "$x"; done
for f in *.sh; do [ -e "$f" ] || continue; echo "$f"; done
i=1; while [ "$i" -le 3 ]; do echo "$i"; i=$((i + 1)); done
until [ -f /tmp/ready ]; do sleep 1; done
while read -r line; do echo "got: $line"; done < file
break leaves the loop, continue jumps to the next round
catch: cmd | while read ... runs the loop in a subshell, so variables set inside
are lost afterwards. fix: send the output to a temp file and loop over it:
  cmd > "$t"; while read -r line; do ...; done < "$t"
there is no seq in plain sh: use the while counter
an unmatched glob stays literal, that is why the [ -e "$f" ] || continue guard is there
exercise: count the lines of every .sh file in a folder
T
cat > "$tmp/ex.sh" <<'X'
for x in one two three; do echo "item $x"; done
i=1
while [ "$i" -le 3 ]; do echo "round $i"; i=$((i + 1)); done
t=$(mktemp)
printf 'a\nb\nc\n' > "$t"
count=0
while read -r line; do count=$((count + 1)); done < "$t"
echo "lines read: $count"
printf 'a\nb\nc\n' | { c2=0; while read -r l; do c2=$((c2 + 1)); done; echo "inside pipe: $c2"; }
rm -f "$t"
X
;;
6) cat <<'T'
FUNCTIONS AND SCOPE
greet() { echo "hi $1"; }        call it: greet berber
$1 $2 .. are the function's own arguments, $# counts them
return gives a status (0-255). to give text back, print it and capture it:
  x=$(greet berber)
plain sh has no local. every variable is global, so:
  give helper variables a prefix (tl_x, ml_i), or
  run the body in a subshell:  f() ( ...body... )   nothing leaks out
  (a subshell also cannot change your variables on purpose)
define a function before the line that calls it
set -- a b c inside a function changes only that function's arguments
exercise: write add() that prints the sum of its two arguments
